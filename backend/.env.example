# Public gateway port; each domain service has a separate port and database.
SERVER_PORT=8080
IDENTITY_PORT=8081
MEDIA_PORT=8082
CLINIC_PORT=8083
SOCIAL_PORT=8084

# New development databases provided by Docker Compose.
# The old DB_URL/DB_USERNAME/DB_PASSWORD are not consumed by the new services.
IDENTITY_DB_URL=jdbc:mysql://localhost:3307/identity_db?allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC
CLINIC_DB_URL=jdbc:mysql://localhost:3308/clinic_db?allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC
SOCIAL_DB_URL=jdbc:mysql://localhost:3309/social_db?allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC
IDENTITY_DB_USERNAME=comemyway
CLINIC_DB_USERNAME=comemyway
SOCIAL_DB_USERNAME=comemyway
IDENTITY_DB_PASSWORD=local-development-password
CLINIC_DB_PASSWORD=local-development-password
SOCIAL_DB_PASSWORD=local-development-password

JWT_SECRET=replace_with_your_own_random_secret_at_least_32_bytes
JWT_ACCESS_EXPIRATION=1800000
JWT_REFRESH_EXPIRATION=604800000

# For local JARs with Compose Redis. Upstash requires REDIS_SSL_ENABLED=true.
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false

BREVO_API_KEY=replace_with_your_brevo_key
BREVO_SENDER_EMAIL=your_verified_sender@example.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_numeric_api_key
CLOUDINARY_API_SECRET=replace_with_your_cloudinary_secret
GEMINI_API_KEY=replace_with_your_gemini_key

# Generate three independent random tokens and set them in the environment.
MEDIA_INTERNAL_TOKEN=
CLINIC_INTERNAL_TOKEN=
SOCIAL_INTERNAL_TOKEN=

# Optional first admin for the NEW development identity database (minimum 12 characters).
# Remove the password after the account is created; existing accounts are never overwritten.
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_USERNAME=devadmin
BOOTSTRAP_ADMIN_EMAIL=devadmin@example.invalid

# Optional URLs if changing service ports:
# IDENTITY_SERVICE_URL=http://127.0.0.1:8081
# CLINIC_SERVICE_URL=http://127.0.0.1:8083
# SOCIAL_SERVICE_URL=http://127.0.0.1:8084
# MEDIA_SERVICE_URL=http://127.0.0.1:8082
